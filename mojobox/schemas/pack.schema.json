{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mojobox.dev/schemas/pack-v1alpha1.json",
  "title": "Mojobox Pack v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "metadata", "components"],
  "properties": {
    "$schema": { "const": "https://mojobox.dev/schemas/pack-v1alpha1.json" },
    "apiVersion": { "const": "packs.mojobox.dev/v1alpha1" },
    "kind": { "const": "Pack" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "category": { "enum": ["function", "appearance", "workflow"] }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "required"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "version": { "$ref": "#/$defs/semver" },
          "required": { "type": "boolean" }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os"],
            "properties": {
              "os": { "enum": ["win32", "linux", "darwin"] },
              "arch": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["x64", "arm64"] }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9][a-z0-9-]*)+$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
  }
}
