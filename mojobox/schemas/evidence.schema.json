{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mojobox.dev/schemas/evidence-v1alpha1.json",
  "title": "Mojobox Evidence v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "subject", "manifestDigest", "specifications", "suite", "issuer", "evidenceLevel", "result", "checks", "testedAt", "revoked"],
  "properties": {
    "$schema": { "const": "https://mojobox.dev/schemas/evidence-v1alpha1.json" },
    "apiVersion": { "const": "evidence.mojobox.dev/v1alpha1" },
    "kind": { "const": "Evidence" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifactDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "hostDescriptorDigest": { "$ref": "#/$defs/digest" },
    "specifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dshStdRevision"],
      "properties": {
        "dshStdRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "admissionProfile": { "type": "string", "minLength": 1 }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "issuer": { "type": "string", "minLength": 1 },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "adapterVersion", "dshVersion", "runtime"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "dshVersion": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceLevel": { "enum": ["Declared", "Parsed", "Negotiated", "Tested", "Observed", "Attested"] },
    "result": { "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "skip"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revoked": { "type": "boolean" },
    "revokedAt": { "type": "string", "format": "date-time" },
    "revocationReason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "evidenceLevel": { "enum": ["Negotiated", "Tested", "Observed", "Attested"] } } },
      "then": {
        "required": ["hostDescriptorDigest", "host"],
        "properties": {
          "hostDescriptorDigest": {},
          "host": {}
        }
      }
    },
    {
      "if": { "properties": { "revoked": { "const": true } } },
      "then": {
        "required": ["revokedAt", "revocationReason"],
        "properties": {
          "revokedAt": {},
          "revocationReason": {}
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
