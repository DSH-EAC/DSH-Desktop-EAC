{
  "name": "@dsh-eac/pack-installer",
  "version": "1.0.0",
  "private": true,
  "description": "EAC 整合包安装器：在 DSH 设置页浏览 EAC/Mojobox 整合包，按分级勾选并一键安装（离线内嵌快照）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": "0.1.7-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [],
      "immediately": false
    }
  },
  "scripts": {
    "build": "npm run build:snapshot && node scripts/build.mjs",
    "build:snapshot": "node scripts/build-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "node --test \"src/**/*.test.ts\"", 
    "smoke": "node scripts/smoke-dsh-home.mjs",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
