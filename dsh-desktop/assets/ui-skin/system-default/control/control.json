{
  "id": "system.default.control",
  "name": "EAC minimal controls",
  "type": "control",
  "version": "2.0.0",
  "owner": "io.github.dsh-eac",
  "compatibility": {
    "profile": "dsh-desktop-eac-ui-skin-profile@^0.3",
    "forceable": false
  },
  "assets": ["layout.css"],
  "declarations": [
    {
      "region": "top-sidebar",
      "controls": ["sidebar-root", "sidebar-header", "sidebar-content", "sidebar-footer", "sidebar-resizer", "sidebar-collapse-toggle", "window-icon", "window-title", "window-badge", "window-actions", "window-minimize", "window-maximize", "window-close"],
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "bottom-sidebar",
      "controls": ["sidebar-root", "sidebar-header", "sidebar-content", "sidebar-footer", "sidebar-resizer", "sidebar-collapse-toggle"],
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "left-sidebar",
      "controls": ["sidebar-root", "sidebar-header", "sidebar-content", "sidebar-footer", "sidebar-resizer", "sidebar-collapse-toggle", "entry-list", "toolbar"],
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "right-sidebar",
      "controls": ["sidebar-root", "sidebar-header", "sidebar-content", "sidebar-footer", "sidebar-resizer", "sidebar-collapse-toggle", "entry-list", "toolbar"],
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "session",
      "controls": ["session-root", "session-toolbar", "session-content", "conversation-list", "message-list", "composer", "composer-input", "composer-actions", "submit-button", "stop-button", "attachment-list"],
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "overlay",
      "controls": ["overlay-root", "overlay-backdrop", "overlay-content", "overlay-close"],
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    }
  ],
  "instanceControls": [
    {
      "kind": "popup",
      "controls": ["popup-trigger", "popup-surface", "popup-content", "popup-close"]
    },
    {
      "kind": "dialog",
      "controls": ["dialog-backdrop", "dialog-surface", "dialog-title", "dialog-body", "dialog-actions", "dialog-close"]
    },
    {
      "kind": "floating-window",
      "controls": ["floating-window-root", "floating-window-titlebar", "floating-window-content", "floating-window-close", "floating-window-dock", "floating-window-resizer"]
    }
  ],
  "privateControls": [
    "system.default.shell-page",
    "system.default.shell-content",
    "system.default.shell-title",
    "system.default.shell-status",
    "system.default.shell-log-path",
    "system.default.shell-actions",
    "system.default.loading-spinner",
    "system.default.restart-button",
    "system.default.exit-minimize",
    "system.default.exit-quit",
    "system.default.window-minimize-icon",
    "system.default.window-maximize-icon",
    "system.default.window-restore-icon",
    "system.default.window-close-icon",
    "system.default.dialog-scroll-area",
    "system.default.dialog-panel"
  ],
  "consumers": [
    "tauri-shell/src/main.rs",
    "tauri-shell/src/exit-overlay.js",
    "tauri-shell/sidecar/bridge.ts"
  ]
}
