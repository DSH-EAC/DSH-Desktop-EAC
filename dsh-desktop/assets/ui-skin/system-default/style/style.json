{
  "id": "system.default.style",
  "name": "EAC minimal visual style",
  "type": "style",
  "version": "2.0.0",
  "owner": "io.github.dsh-eac",
  "compatibility": {
    "profile": "dsh-desktop-eac-ui-skin-profile@^0.3",
    "forceable": false
  },
  "assets": ["tokens.css", "states.css"],
  "declarations": [
    {
      "region": "top-sidebar",
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "bottom-sidebar",
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "left-sidebar",
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "right-sidebar",
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "session",
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    },
    {
      "region": "overlay",
      "states": ["empty", "idle", "loading", "running", "success", "warning", "error", "disabled", "collapsed", "hidden", "docked", "floating", "detached", "dragging", "drop-target", "dangerous", "animating"]
    }
  ]
}
