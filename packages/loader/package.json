{
  "name": "@dsh-eac/ui-skin-loader",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "description": "DSH UI 皮肤加载器：弱约束公约 dsh.ecosystem.ui-skin-loader/v1 的参考实现（皮肤发现登记 / 全局互斥切换 / 持久化恢复 / 故障隔离 / 换肤控制台）。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "dsh": "0.1.7-rc.2",
    "node": ">=24"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": [],
      "immediately": false
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
